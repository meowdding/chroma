{
    "schemaVersion": 1,
    "id": "meowdding-chroma",
    "version": "${version}",
    "name": "Meowdding Chroma",
    "description": "Chroma Library for Text and similar.",
    "license": "ARR",
    "icon": "assets/meowdding-chroma/icon.png",
    "environment": "client",
    "entrypoints": {
        "main": [
            {
                "adapter": "kotlin",
                "value": "me.owdding.chroma.MeowddingChroma"
            }
        ]
    },
    "mixins": [
        "meowdding-chroma.mixins.json"
    ],
    "accessWidener": "meowdding-chroma.ct",
    "depends": {
        "fabricloader": ">=${fl}",
        "minecraft": "${minecraft}",
        "fabric-language-kotlin": ">=${flk}"
    },
    "custom": {
        "modmenu": {
            "badges": [
                "library"
            ]
        }
    }
}
